  <diagram id="pagina4" name="Parte 2 - Questao 6 - Tabela comparativa">
    <mxGraphModel dx="1100" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="c0_0" value="Criterio" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;align=center;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="60" width="150" height="40" as="geometry" />
        </mxCell>
        <mxCell id="c0_1" value="FastAPI puro (P1 Q1 e Q2)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;align=center;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="190" y="60" width="290" height="40" as="geometry" />
        </mxCell>
        <mxCell id="c0_2" value="FastAPI + LangChain (P2 Q2 e Q3)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;align=center;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="480" y="60" width="290" height="40" as="geometry" />
        </mxCell>
        <mxCell id="c1_0" value="Facilidade de uso&#10;e configuracao" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;verticalAlign=middle;spacingLeft=6;" vertex="1" parent="1">
          <mxGeometry x="40" y="100" width="150" height="90" as="geometry" />
        </mxCell>
        <mxCell id="c1_1" value="Duas dependencias e tres linhas&#10;para o pipeline. Sem abstracao&#10;nova, mas trocar de provedor&#10;exige reescrever o codigo." style="rounded=0;whiteSpace=wrap;html=1;dashed=1;verticalAlign=top;fontStyle=1;fontSize=12;fillColor=#f8f8f8;strokeColor=#999999;align=left;verticalAlign=middle;spacingLeft=6;" vertex="1" parent="1">
          <mxGeometry x="190" y="100" width="290" height="90" as="geometry" />
        </mxCell>
        <mxCell id="c1_2" value="Exige entender Runnable,&#10;PromptTemplate e parser.&#10;Em troca, a mesma cadeia serve&#10;para Fake LLM, OpenAI ou HF." style="rounded=0;whiteSpace=wrap;html=1;dashed=1;verticalAlign=top;fontStyle=1;fontSize=12;fillColor=#f8f8f8;strokeColor=#999999;align=left;verticalAlign=middle;spacingLeft=6;" vertex="1" parent="1">
          <mxGeometry x="480" y="100" width="290" height="90" as="geometry" />
        </mxCell>
        <mxCell id="c2_0" value="Latencia e&#10;desempenho" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;verticalAlign=middle;spacingLeft=6;" vertex="1" parent="1">
          <mxGeometry x="40" y="190" width="150" height="90" as="geometry" />
        </mxCell>
        <mxCell id="c2_1" value="Local, sem rede. Dominada pela&#10;CPU: centenas de ms a alguns&#10;segundos por frase. Primeira&#10;chamada carrega o modelo." style="rounded=0;whiteSpace=wrap;html=1;dashed=1;verticalAlign=top;fontStyle=1;fontSize=12;fillColor=#f8f8f8;strokeColor=#999999;align=left;verticalAlign=middle;spacingLeft=6;" vertex="1" parent="1">
          <mxGeometry x="190" y="190" width="290" height="90" as="geometry" />
        </mxCell>
        <mxCell id="c2_2" value="Com OpenAI: rede de 0,3 a 2 s,&#10;mas hardware potente.&#10;Com HF local: igual a coluna&#10;ao lado mais um pequeno overhead." style="rounded=0;whiteSpace=wrap;html=1;dashed=1;verticalAlign=top;fontStyle=1;fontSize=12;fillColor=#f8f8f8;strokeColor=#999999;align=left;verticalAlign=middle;spacingLeft=6;" vertex="1" parent="1">
          <mxGeometry x="480" y="190" width="290" height="90" as="geometry" />
        </mxCell>
        <mxCell id="c3_0" value="Flexibilidade de&#10;modelos" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;verticalAlign=middle;spacingLeft=6;" vertex="1" parent="1">
          <mxGeometry x="40" y="280" width="150" height="90" as="geometry" />
        </mxCell>
        <mxCell id="c3_1" value="Boa dentro do HuggingFace&#10;(basta mudar o model_id);&#10;fora dele e preciso escrever&#10;um cliente novo." style="rounded=0;whiteSpace=wrap;html=1;dashed=1;verticalAlign=top;fontStyle=1;fontSize=12;fillColor=#f8f8f8;strokeColor=#999999;align=left;verticalAlign=middle;spacingLeft=6;" vertex="1" parent="1">
          <mxGeometry x="190" y="280" width="290" height="90" as="geometry" />
        </mxCell>
        <mxCell id="c3_2" value="Interface unica para modelo&#10;local e de API, troca por&#10;variavel de ambiente, alem de&#10;memoria, RAG e agentes." style="rounded=0;whiteSpace=wrap;html=1;dashed=1;verticalAlign=top;fontStyle=1;fontSize=12;fillColor=#f8f8f8;strokeColor=#999999;align=left;verticalAlign=middle;spacingLeft=6;" vertex="1" parent="1">
          <mxGeometry x="480" y="280" width="290" height="90" as="geometry" />
        </mxCell>
        <mxCell id="c4_0" value="Custo e&#10;escalabilidade" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;verticalAlign=middle;spacingLeft=6;" vertex="1" parent="1">
          <mxGeometry x="40" y="370" width="150" height="90" as="geometry" />
        </mxCell>
        <mxCell id="c4_1" value="Custo fixo de infra e custo&#10;marginal zero. Escalar replica&#10;o modelo em cada worker&#10;(RAM, GPU, cold start)." style="rounded=0;whiteSpace=wrap;html=1;dashed=1;verticalAlign=top;fontStyle=1;fontSize=12;fillColor=#f8f8f8;strokeColor=#999999;align=left;verticalAlign=middle;spacingLeft=6;" vertex="1" parent="1">
          <mxGeometry x="190" y="370" width="290" height="90" as="geometry" />
        </mxCell>
        <mxCell id="c4_2" value="Custo por token sujeito a&#10;rate limit, mas escala sem&#10;provisionar GPU. Com HF local,&#10;herda as limitacoes locais." style="rounded=0;whiteSpace=wrap;html=1;dashed=1;verticalAlign=top;fontStyle=1;fontSize=12;fillColor=#f8f8f8;strokeColor=#999999;align=left;verticalAlign=middle;spacingLeft=6;" vertex="1" parent="1">
          <mxGeometry x="480" y="370" width="290" height="90" as="geometry" />
        </mxCell>
        <mxCell id="c5_0" value="Prototipo x&#10;producao" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;verticalAlign=middle;spacingLeft=6;" vertex="1" parent="1">
          <mxGeometry x="40" y="460" width="150" height="90" as="geometry" />
        </mxCell>
        <mxCell id="c5_1" value="Prototipo direto e didatico.&#10;Producao exige batching, fila&#10;e servidor de inferencia&#10;dedicado." style="rounded=0;whiteSpace=wrap;html=1;dashed=1;verticalAlign=top;fontStyle=1;fontSize=12;fillColor=#f8f8f8;strokeColor=#999999;align=left;verticalAlign=middle;spacingLeft=6;" vertex="1" parent="1">
          <mxGeometry x="190" y="460" width="290" height="90" as="geometry" />
        </mxCell>
        <mxCell id="c5_2" value="Prototipo imbativel com Fake LLM.&#10;Producao viavel com atencao a&#10;versionamento, observabilidade,&#10;retries e controle de custo." style="rounded=0;whiteSpace=wrap;html=1;dashed=1;verticalAlign=top;fontStyle=1;fontSize=12;fillColor=#f8f8f8;strokeColor=#999999;align=left;verticalAlign=middle;spacingLeft=6;" vertex="1" parent="1">
          <mxGeometry x="480" y="460" width="290" height="90" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
